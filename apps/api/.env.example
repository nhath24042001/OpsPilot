NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
API_PUBLIC_URL=http://localhost:3000

DATABASE_URL=postgresql://opspilot:opspilot@localhost:5432/opspilot?schema=public
REDIS_URL=redis://:opspilot@localhost:6379
RABBITMQ_URL=amqp://opspilot:opspilot@localhost:5672

MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=opspilot
MINIO_SECRET_KEY=opspilot-secret
MINIO_BUCKET=opspilot

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_CALLBACK_URL=http://localhost:3000/auth/oauth/google/callback
