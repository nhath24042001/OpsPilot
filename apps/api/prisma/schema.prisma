generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationMemberStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum OAuthProvider {
  GOOGLE
  GITHUB
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum ServiceStatus {
  ACTIVE
  DEPRECATED
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  CANCELED
}

enum IncidentSeverity {
  SEV1
  SEV2
  SEV3
  SEV4
}

enum IncidentTimelineEventType {
  INCIDENT_CREATED
  INCIDENT_ACKNOWLEDGED
  INCIDENT_ASSIGNED
  INCIDENT_RESOLVED
  INCIDENT_CANCELED
  COMMENT_ADDED
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

enum FileUploadStatus {
  PENDING_UPLOAD
  UPLOADED
}

enum KnowledgeDocumentStatus {
  PENDING_UPLOAD
  PENDING_INDEX
  INDEXING
  INDEXED
  INDEX_FAILED
}

enum AssistantMessageRole {
  USER
  ASSISTANT
}

model User {
  id             String               @id @default(uuid()) @db.Uuid
  email          String               @unique
  name           String?
  imageUrl       String?              @map("image_url")
  passwordHash   String?
  emailVerified  Boolean              @default(false)
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  deletedAt      DateTime?            @map("deleted_at")
  authTokens     AuthToken[]
  refreshTokens  RefreshToken[]
  oauthAccounts  OAuthAccount[]
  memberships    OrganizationMember[]
  assistantConversations AssistantConversation[]
  generatedPostmortems Postmortem[]

  @@map("users")
}

model AuthToken {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  tokenHash  String           @unique @map("token_hash")
  purpose    AuthTokenPurpose
  expiresAt  DateTime         @map("expires_at")
  consumedAt DateTime?        @map("consumed_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([purpose, expiresAt])
  @@map("auth_tokens")
}

model OAuthAccount {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  provider          OAuthProvider
  providerAccountId String        @map("provider_account_id")
  imageUrl          String?       @map("image_url")
  accessToken       String?       @map("access_token")
  refreshToken      String?       @map("refresh_token")
  expiresAt         DateTime?     @map("expires_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  deletedAt         DateTime?     @map("deleted_at")
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model RefreshToken {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String         @map("user_id") @db.Uuid
  tokenHash         String         @unique @map("token_hash")
  familyId          String         @map("family_id") @db.Uuid
  replacedByTokenId String?        @map("replaced_by_token_id") @db.Uuid
  revokedAt         DateTime?      @map("revoked_at")
  rotatedAt         DateTime?      @map("rotated_at")
  expiresAt         DateTime       @map("expires_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedByToken   RefreshToken?  @relation("RefreshTokenRotation", fields: [replacedByTokenId], references: [id])
  replacedTokens    RefreshToken[] @relation("RefreshTokenRotation")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Organization {
  id          String               @id @default(uuid()) @db.Uuid
  name        String
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  deletedAt   DateTime?            @map("deleted_at")
  memberships OrganizationMember[]
  roles       Role[]
  services    Service[]
  incidents   Incident[]
  files       File[]
  knowledgeDocuments KnowledgeDocument[]
  knowledgeChunks KnowledgeChunk[]
  assistantConversations AssistantConversation[]
  postmortems Postmortem[]

  @@map("organizations")
}

model OrganizationMember {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  userId         String                   @map("user_id") @db.Uuid
  status         OrganizationMemberStatus @default(ACTIVE)
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")
  deletedAt      DateTime?                @map("deleted_at")
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles          MemberRole[]
  ownedServices  Service[]                @relation("ServiceOwner")
  commandedIncidents Incident[]           @relation("IncidentCommander")
  assignedIncidents  Incident[]           @relation("IncidentAssignee")
  timelineEvents IncidentTimelineEvent[]   @relation("TimelineActor")
  comments       IncidentComment[]         @relation("CommentAuthor")
  files          File[]                    @relation("FileCreator")
  knowledgeDocuments KnowledgeDocument[]   @relation("KnowledgeDocumentCreator")

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model Role {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  name           String
  isSystem       Boolean          @default(false) @map("is_system")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  deletedAt      DateTime?        @map("deleted_at")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions    RolePermission[]
  members        MemberRole[]

  @@unique([organizationId, name])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model MemberRole {
  memberId String             @map("member_id") @db.Uuid
  roleId   String             @map("role_id") @db.Uuid
  member   OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role     Role               @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([memberId, roleId])
  @@map("member_roles")
}

model Service {
  id             String                    @id @default(uuid()) @db.Uuid
  organizationId String                    @map("organization_id") @db.Uuid
  ownerMemberId  String?                   @map("owner_member_id") @db.Uuid
  name           String
  description    String?
  status         ServiceStatus             @default(ACTIVE)
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")
  deletedAt      DateTime?                 @map("deleted_at")
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerMember    OrganizationMember?       @relation("ServiceOwner", fields: [ownerMemberId], references: [id], onDelete: SetNull)
  incidents      Incident[]

  @@unique([organizationId, name])
  @@index([organizationId, status, createdAt])
  @@map("services")
}

model Incident {
  id                String              @id @default(uuid()) @db.Uuid
  organizationId    String              @map("organization_id") @db.Uuid
  serviceId         String?             @map("service_id") @db.Uuid
  commanderMemberId String?             @map("commander_member_id") @db.Uuid
  assignedMemberId  String?             @map("assigned_member_id") @db.Uuid
  title             String
  description       String?
  severity          IncidentSeverity
  status            IncidentStatus      @default(OPEN)
  rootCause         String?             @map("root_cause")
  resolution        String?
  acknowledgedAt    DateTime?           @map("acknowledged_at")
  resolvedAt        DateTime?           @map("resolved_at")
  canceledAt        DateTime?           @map("canceled_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  deletedAt         DateTime?           @map("deleted_at")
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service           Service?            @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  commanderMember   OrganizationMember? @relation("IncidentCommander", fields: [commanderMemberId], references: [id], onDelete: SetNull)
  assignedMember    OrganizationMember? @relation("IncidentAssignee", fields: [assignedMemberId], references: [id], onDelete: SetNull)
  timelineEvents    IncidentTimelineEvent[]
  comments          IncidentComment[]
  postmortem        Postmortem?

  @@index([organizationId, status, createdAt])
  @@index([organizationId, severity, createdAt])
  @@index([organizationId, serviceId, createdAt])
  @@map("incidents")
}

model IncidentTimelineEvent {
  id             String                    @id @default(uuid()) @db.Uuid
  organizationId String                    @map("organization_id") @db.Uuid
  incidentId     String                    @map("incident_id") @db.Uuid
  actorMemberId  String?                   @map("actor_member_id") @db.Uuid
  type           IncidentTimelineEventType
  message        String?
  metadata       Json                      @default("{}")
  createdAt      DateTime                  @default(now()) @map("created_at")
  incident       Incident                  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actorMember    OrganizationMember?       @relation("TimelineActor", fields: [actorMemberId], references: [id], onDelete: SetNull)

  @@index([organizationId, incidentId, createdAt])
  @@map("incident_timeline_events")
}

model IncidentComment {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  incidentId     String              @map("incident_id") @db.Uuid
  authorMemberId String              @map("author_member_id") @db.Uuid
  body           String
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  deletedAt      DateTime?           @map("deleted_at")
  incident       Incident            @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  authorMember   OrganizationMember  @relation("CommentAuthor", fields: [authorMemberId], references: [id], onDelete: Cascade)

  @@index([organizationId, incidentId, createdAt])
  @@map("incident_comments")
}

model OutboxEvent {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String?           @map("organization_id") @db.Uuid
  aggregateType  String            @map("aggregate_type")
  aggregateId    String            @map("aggregate_id") @db.Uuid
  eventType      String            @map("event_type")
  routingKey     String            @map("routing_key")
  payload        Json
  status         OutboxEventStatus @default(PENDING)
  attempts       Int               @default(0)
  availableAt    DateTime          @default(now()) @map("available_at")
  publishedAt    DateTime?         @map("published_at")
  lastError      String?           @map("last_error")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

model ProcessedMessage {
  messageId    String   @map("message_id")
  consumerName String   @map("consumer_name")
  processedAt  DateTime @default(now()) @map("processed_at")

  @@id([messageId, consumerName])
  @@map("processed_messages")
}

model File {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  objectKey      String           @unique @map("object_key")
  originalName   String           @map("original_name")
  contentType    String           @map("content_type")
  byteSize       BigInt           @map("byte_size")
  status         FileUploadStatus @default(PENDING_UPLOAD)
  createdByMemberId String        @map("created_by_member_id") @db.Uuid
  uploadedAt     DateTime?        @map("uploaded_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByMember OrganizationMember @relation("FileCreator", fields: [createdByMemberId], references: [id], onDelete: Cascade)
  knowledgeDocument KnowledgeDocument?

  @@index([organizationId, status, createdAt])
  @@map("files")
}

model KnowledgeDocument {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  fileId         String                  @unique @map("file_id") @db.Uuid
  title          String
  status         KnowledgeDocumentStatus @default(PENDING_INDEX)
  indexError     String?                 @map("index_error")
  indexedAt      DateTime?               @map("indexed_at")
  createdByMemberId String               @map("created_by_member_id") @db.Uuid
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  file           File                    @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdByMember OrganizationMember     @relation("KnowledgeDocumentCreator", fields: [createdByMemberId], references: [id], onDelete: Cascade)
  chunks         KnowledgeChunk[]

  @@index([organizationId, status, createdAt])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  documentId     String            @map("document_id") @db.Uuid
  chunkIndex     Int               @map("chunk_index")
  content        String
  tokenCount     Int               @map("token_count")
  embedding      Unsupported("vector(8)")
  createdAt      DateTime          @default(now()) @map("created_at")
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document       KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([organizationId, documentId])
  @@map("knowledge_chunks")
}

model AssistantConversation {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  userId         String             @map("user_id") @db.Uuid
  question       String
  answer         String
  sources        Json               @default("[]")
  createdAt      DateTime           @default(now()) @map("created_at")
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       AssistantMessage[]

  @@index([organizationId, createdAt])
  @@map("assistant_conversations")
}

model AssistantMessage {
  id             String                @id @default(uuid()) @db.Uuid
  conversationId String                @map("conversation_id") @db.Uuid
  role           AssistantMessageRole
  content        String
  createdAt      DateTime              @default(now()) @map("created_at")
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("assistant_messages")
}

model Postmortem {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  incidentId     String       @unique @map("incident_id") @db.Uuid
  generatedByUserId String    @map("generated_by_user_id") @db.Uuid
  title          String
  content        String
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incident       Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  generatedBy    User         @relation(fields: [generatedByUserId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("postmortems")
}
